#!/bin/sh
[ -f /etc/config/fstab ] && exit 0

# Generate detected mount/swap entries, excluding system-managed /overlay and /rom.
# block detect may emit its own "config global" section; remove it so the
# global settings appended below are the only global section.
block detect | grep -v -E "target '(/(overlay|rom))'" | awk '
/^[[:space:]]*config[[:space:]]+global([[:space:]]|$)/ {
	skip_global = 1
	next
}
/^[[:space:]]*config[[:space:]]+/ {
	skip_global = 0
}
!skip_global {
	print
}
' > /etc/config/fstab

# Keep exactly one global section. Disable anonymous mounts to prevent
# unrelated partitions (including vendor WIFIFW volumes) from being mounted.
cat >> /etc/config/fstab <<EOF
config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '0'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'
EOF

exit 0
