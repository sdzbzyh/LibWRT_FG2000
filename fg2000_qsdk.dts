			phandle = <0x4b>;
			reg = <0x03>;
			voltage-tolerance = <0x01>;
		};

		l2-cache {
			cache-level = <0x02>;
			compatible = "cache";
			phandle = <0x57>;
		};

		opp_table0 {
			compatible = "operating-points-v2";
			opp-shared;
			phandle = <0x58>;

			opp00 {
				clock-latency-ns = <0x30d40>;
				opp-hz = <0x00 0x00>;
				opp-microvolt = <0x00>;
			};

			opp01 {
				clock-latency-ns = <0x30d40>;
