/dts-v1/;

/memreserve/	0x000000004a1ec000 0x0000000000011000;
/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	boot_version = <0x43524d2d 0x424f4f54 0x2e42462e 0x332e332e 0x312d3030 0x3135380a>;
	compatible = "inseego,fg2000", "qcom,ipq8074-ap-hk09", "qcom,ipq8074";
	cpu_type = <0x85010000>;
	flash_type = <0x8000000>;
	interrupt-parent = <0x01>;
	machid = <0x8000108>;
	model = "Inseego FG2000";
	qcom,board-id = <0x08 0x00>;
	qcom,msm-id = <0x157 0x00 0x187 0x00>;
	qcom,pmic-id = <0x00 0x00 0x00 0x00>;
	rpm_version = [43 52 4d 2d 52 50 4d 2e 42 46 2e 32 2e 34 2e 31 2d 30 30 30 38 37 0a];
	soc_version_major = <0x2000000>;
	soc_version_minor = <0x00>;
	tz_version = [43 52 4d 2d 54 5a 2e 42 46 2e 34 2e 30 2e 38 2d 30 30 31 39 36 0a];

	aliases {
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
		ethernet5 = "/soc/dp6";
		sdhc1 = "/soc/sdhci@7824900";
		serial0 = "/soc/serial@78b3000";
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8 root=PARTUUID=18493d5d-66f2-22c1-6e05-0a0d585f86de rootwait";
		bootargs-append = " swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0";
	};

	clocks {

		bias_pll_cc_clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x11e1a300>;
			compatible = "fixed-clock";
		};

		bias_pll_nss_noc_clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x18d34920>;
			compatible = "fixed-clock";
		};

		sleep_clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			compatible = "fixed-clock";
			phandle = <0x09>;
		};

		xo {
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			compatible = "fixed-clock";
			phandle = <0x0e>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
