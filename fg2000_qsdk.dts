				vadc@3100 {
					#address-cells = <0x01>;
					#io-channel-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "qcom,pmp8074-spmi-vadc";
					interrupts = <0x00 0x31 0x00 0x01>;
					reg = <0x3100 0x100>;

					die_temp {
						reg = <0x06>;
					};

					pa_therm1 {
						qcom,vadc-thermal-node;
						reg = <0x0d>;
					};

					pa_therm2 {
						qcom,vadc-thermal-node;
						reg = <0x0e>;
					};

					pa_therm3 {
						qcom,vadc-thermal-node;
						reg = <0x0f>;
					};
				};
			};

			pmic@1 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;

				regulators {
					compatible = "qcom,pmd9655-regulators";
					vdd_ldo11-supply = <0x17>;
					vdd_s3-supply = <0x17>;
					vdd_s4-supply = <0x17>;

					ldo11 {
						phandle = <0x10>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x10d880>;
						regulator-name = "pmd9655_ldo11";
					};

					s3 {
						phandle = <0x53>;
						regulator-always-on;
						regulator-boot-on;
						regulator-max-microvolt = <0x103c40>;
						regulator-min-microvolt = <0x90880>;
						regulator-name = "pmd9655_s3";
					};

					s4 {
						phandle = <0x54>;
						regulator-always-on;
						regulator-boot-on;
						regulator-max-microvolt = <0xf2300>;
						regulator-min-microvolt = <0xadd40>;
						regulator-name = "pmd9655_s4";
					};
				};
			};
		};

