				opp-microvolt = <0x03>;
			};

			opp04 {
				clock-latency-ns = <0x30d40>;
				opp-hz = <0x00 0x6ddd0000>;
				opp-microvolt = <0x04>;
			};

			opp05 {
				clock-latency-ns = <0x30d40>;
				opp-hz = <0x00 0x7270e000>;
				opp-microvolt = <0x05>;
