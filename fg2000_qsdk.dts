				clock-output-names = "gcc_pcie1_pipe_clk_src";
				clocks = <0x0a 0x79>;
				phandle = <0x23>;
				reg = <0x8e200 0x130 0x8e400 0x200 0x8e800 0x1f8>;
			};
		};

		pinctrl@1000000 {
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
			compatible = "qcom,ipq8074-pinctrl";
			gpio-controller;
			interrupt-controller;
			interrupts = <0x00 0xd0 0x04>;
			phandle = <0x11>;
			pinctrl-0 = <0x08>;
			pinctrl-names = "default";
			reg = <0x1000000 0x300000>;

			button_pins {
				phandle = <0x56>;

				reset_button {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio1";
				};

				wps_button {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio47";
				};
			};

			fan_en_gpio {
				phandle = <0x55>;

				mux {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio8";
				};
			};

			hsuart-pins {
				bias-disable;
				drive-strength = <0x08>;
				function = "blsp2_uart";
				phandle = <0x14>;
				pins = "gpio46", "gpio47", "gpio48", "gpio49";
			};

			i2c-0-pinmux {
				bias-disable;
				drive-strength = <0x08>;
				function = "blsp1_i2c";
				phandle = <0x16>;
				pins = "gpio42", "gpio43";
			};

			mdio_pinmux {
				phandle = <0x2a>;

				mux_0 {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "mdc";
					pins = "gpio68";
				};

				mux_1 {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "mdio";
					pins = "gpio69";
				};

				mux_2 {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio50";
				};
			};

			pa_ctrl_pin {
				bias-pull-up;
				drive-strength = <0x08>;
				function = "gpio";
				output-high;
				phandle = <0x08>;
				pins = "gpio0";
			};

			pcie0_wake_gpio {
				phandle = <0x22>;

				pcie0_wake {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "pcie0_wake";
					pins = "gpio59";
				};
			};

			pcie_sdx_gpio {
				phandle = <0x21>;

				ap2mdm_err_ftl {
					bias-pull-down;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio27";
				};

				ap2mdm_status {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					output-high;
					pins = "gpio26";
				};

				mdm2ap_err_ftl {
					bias-pull-down;
					drive-strength = <0x08>;
					function = "gpio";
					pins = "gpio33";
				};

				sdx_pon_gpio {
					bias-pull-up;
					drive-strength = <0x08>;
					function = "gpio";
					output-high;
					pins = "gpio5";
				};
			};

			qpic-pins {
				bias-disable;
				drive-strength = <0x08>;
				function = "qpic";
				phandle = <0x19>;
				pins = "gpio1", "gpio3", "gpio4", "gpio5", "gpio6", "gpio7", "gpio8", "gpio10", "gpio11", "gpio12", "gpio13", "gpio14", "gpio15", "gpio17";
			};

			serial4-pinmux {
				bias-disable;
				drive-strength = <0x08>;
				function = "blsp4_uart1";
				phandle = <0x0c>;
				pins = "gpio23", "gpio24";
			};

			spi-0-pins {
				bias-disable;
				drive-strength = <0x08>;
				function = "blsp0_spi";
				phandle = <0x15>;
				pins = "gpio38", "gpio39", "gpio40", "gpio41";
			};
		};

